# =================================================================
# SECURE EVIDENCE BACKEND ENVIRONMENT CONFIGURATION (.env)
# =================================================================

# -----------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL)
# -----------------------------------------------------------------
# Supabase Database URL (Obtained from Supabase Project Settings -> Database -> Connection String -> URI)
# Format: postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.xxxx:your_supabase_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# -----------------------------------------------------------------
# 2. AUTHENTICATION (JWT)
# -----------------------------------------------------------------
# Secret key used for signing & verifying JWT authentication tokens (Must be at least 16 characters)
JWT_SECRET="super-secret-jwt-key-change-in-production-2026"

# -----------------------------------------------------------------
# 3. SERVER CONFIGURATION
# -----------------------------------------------------------------
PORT=5000
NODE_ENV="development"

# -----------------------------------------------------------------
# 4. AWS S3 STORAGE CONFIGURATION
# -----------------------------------------------------------------
# AWS S3 Bucket Credentials & Region
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
S3_BUCKET_NAME="secure-evidence-dev-bucket"

# -----------------------------------------------------------------
# 5. BLOCKCHAIN CONFIGURATION (Hardhat Local Node Defaults)
# -----------------------------------------------------------------
# Local Hardhat Ethereum Testnet Node RPC
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
BLOCKCHAIN_CHAIN_ID=31337

# Default Hardhat Deployer Private Key (Pre-funded Account #0)
BLOCKCHAIN_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# Address of deployed EvidenceRegistry contract (Updated after running npm run blockchain:deploy)
BLOCKCHAIN_CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"
