generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CaseStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum CaseParticipantStatus {
  ACTIVE
  REMOVED
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum BlockchainAnchorStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum AuditEventType {
  CASE_CREATED
  USER_ADDED
  DOCUMENT_CREATED
  DOCUMENT_VIEWED
  DOCUMENT_DOWNLOADED
  DOCUMENT_VERIFIED
  DOCUMENT_VERSION_CREATED
  ACCESS_DENIED
  EVIDENCE_CREATED
  CUSTODY_TRANSFER_INITIATED
  CUSTODY_TRANSFER_ACCEPTED
  CUSTODY_TRANSFER_REJECTED
}

enum EvidenceStatus {
  ACTIVE
  IN_TRANSFER
  RELEASED
  ARCHIVED
}

enum CustodyTransferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMembership[]
  roles       Role[]
  cases       Case[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      OrganizationMembership[]
  caseParticipants CaseParticipant[]
  createdCases     Case[]                   @relation("CaseCreator")

  uploadedVersions DocumentVersion[]

  auditEvents AuditEvent[]

  currentEvidenceCustodies  Evidence[]        @relation("CurrentEvidenceCustodian")
  createdEvidence           Evidence[]        @relation("EvidenceCreator")
  custodyTransfersFrom      CustodyTransfer[] @relation("CustodyTransfersFrom")
  custodyTransfersTo        CustodyTransfer[] @relation("CustodyTransfersTo")
  initiatedCustodyTransfers CustodyTransfer[] @relation("CustodyTransferInitiator")
  custodyEventsFrom         CustodyEvent[]    @relation("CustodyEventsFrom")
  custodyEventsTo           CustodyEvent[]    @relation("CustodyEventsTo")
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  roleId         String
  status         MembershipStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Role {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  memberships OrganizationMembership[]
  permissions RolePermission[]

  @@unique([organizationId, name])
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Case {
  id          String     @id @default(cuid())
  caseNumber  String
  title       String
  description String?
  status      CaseStatus @default(OPEN)

  organizationId String
  createdById    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("CaseCreator", fields: [createdById], references: [id])

  participants CaseParticipant[]
  documents    Document[]
  evidence     Evidence[]
  auditEvents  AuditEvent[]

  @@unique([organizationId, caseNumber])
  @@index([organizationId])
  @@index([createdById])
}

model CaseParticipant {
  id     String @id @default(cuid())
  caseId String
  userId String

  isCaseAdmin Boolean               @default(false)
  status      CaseParticipantStatus @default(ACTIVE)

  joinedAt  DateTime  @default(now())
  removedAt DateTime?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([caseId])
  @@index([userId])
}

model Document {
  id     String @id @default(cuid())
  caseId String

  title       String
  description String?

  documentType String?
  status       DocumentStatus @default(ACTIVE)

  currentVersionNumber Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  versions DocumentVersion[]

  @@index([caseId])
  @@index([status])
}

model DocumentVersion {
  id         String @id @default(cuid())
  documentId String

  versionNumber Int

  originalFileName String
  mimeType         String
  fileSize         BigInt

  sha256Hash String

  storageProvider String
  storageBucket   String
  storageKey      String

  uploadedById String
  uploadedAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  blockchainAnchor BlockchainAnchor?

  evidence Evidence?

  @@unique([documentId, versionNumber])
  @@unique([storageKey])
  @@index([documentId])
  @@index([sha256Hash])
  @@index([uploadedById])
}

model BlockchainAnchor {
  id String @id @default(cuid())

  documentVersionId String @unique

  chainId BigInt

  contractAddress String

  anchorId String @unique

  caseIdHash     String
  documentIdHash String
  contentHash    String

  versionNumber Int

  transactionHash String?
  blockNumber     BigInt?

  status BlockchainAnchorStatus @default(PENDING)

  errorMessage String?

  anchoredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@index([contentHash])
  @@index([transactionHash])
  @@index([status])
  @@index([chainId])
}

model AuditEvent {
  id String @id @default(cuid())

  caseId String

  actorId String?

  eventType AuditEventType

  entityType String?
  entityId   String?

  metadata Json?

  ipAddress String?
  userAgent String?

  sequence Int

  previousHash String?
  eventHash    String

  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([caseId, sequence])
  @@index([caseId, createdAt])
  @@index([actorId])
  @@index([eventType])
  @@index([eventHash])
}

model Evidence {
  id String @id @default(cuid())

  caseId String

  documentVersionId String @unique

  evidenceNumber String

  title       String
  description String?

  status EvidenceStatus @default(ACTIVE)

  currentCustodianId String?

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  currentCustodian User? @relation("CurrentEvidenceCustodian", fields: [currentCustodianId], references: [id], onDelete: SetNull)

  createdBy User @relation("EvidenceCreator", fields: [createdById], references: [id])

  transfers CustodyTransfer[]

  custodyEvents CustodyEvent[]

  @@unique([caseId, evidenceNumber])
  @@index([caseId])
  @@index([currentCustodianId])
  @@index([status])
}

model CustodyTransfer {
  id String @id @default(cuid())

  evidenceId String

  fromUserId String
  toUserId   String

  initiatedById String

  reason String

  status CustodyTransferStatus @default(PENDING)

  requestedAt DateTime @default(now())

  respondedAt DateTime?

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  fromUser User @relation("CustodyTransfersFrom", fields: [fromUserId], references: [id])

  toUser User @relation("CustodyTransfersTo", fields: [toUserId], references: [id])

  initiatedBy User @relation("CustodyTransferInitiator", fields: [initiatedById], references: [id])

  custodyEvent CustodyEvent?

  @@index([evidenceId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
}

model CustodyEvent {
  id String @id @default(cuid())

  evidenceId String

  transferId String @unique

  sequence Int

  fromUserId String
  toUserId   String

  reason String

  eventHash String

  blockchainAnchorId        String?
  blockchainTransactionHash String?
  blockchainBlockNumber     BigInt?

  createdAt DateTime @default(now())

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  transfer CustodyTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)

  fromUser User @relation("CustodyEventsFrom", fields: [fromUserId], references: [id])

  toUser User @relation("CustodyEventsTo", fields: [toUserId], references: [id])

  @@unique([evidenceId, sequence])
  @@index([evidenceId, sequence])
  @@index([eventHash])
  @@index([blockchainAnchorId])
}
